# Mibunyang environment variables
# Copy this file to .env.local and fill values for local development.

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=          # server only; never expose to the frontend

# Auth
AUTH_SECRET=                   # JWT signing secret; 64 hex chars recommended
ADMIN_EMAIL=                   # admin email address

# Subscriber opt-out
SUBSCRIBERS_OPT_OUT_SECRET=    # HMAC secret for subscriber opt-out tokens

# Vercel KV / Redis
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Frontend variables. VITE_* values are exposed to the browser.
VITE_USE_SUPABASE=true
VITE_KAKAO_JS_KEY=             # Kakao JavaScript key
VITE_KAKAO_REST_API_KEY=       # Kakao OAuth authorize client_id; public REST API key
VITE_KAKAO_CHANNEL_ID=         # Kakao channel ID
VITE_FEATURE_UPCOMING=false

# Server-only external API keys
KAKAO_KEY=                     # Kakao REST API key for infra/place search
KAKAO_REST_API_KEY=            # Kakao OAuth token exchange REST API key; server only
KAKAO_REDIRECT_URI=            # Optional canonical Kakao OAuth redirect URI
KAKAO_CLIENT_SECRET=           # Optional Kakao OAuth client secret; server only
KAKAO_ALLOWED_ORIGINS=         # Comma-separated redirect origins; server only
APPLYHOME_KEY=                 # ApplyHome API key
KOSIS_KEY=                     # KOSIS API key
NEIS_KEY=                      # NEIS API key
DART_KEY=                      # DART API key
FINLIFE_API_KEY=               # Financial Supervisory Service finlife API key
MOLIT_KEY=                     # MOLIT data.go.kr API key
AIRKOREA_KEY=                  # AirKorea API key
SCHOOLINFO_KEY=                # SchoolInfo API key
CHILDCARE_API_KEY=             # info.childcare.go.kr cpmsapi021 (어린이집 목록)
CHILDCARE_BASIC_API_KEY=       # info.childcare.go.kr cpmsapi030 (어린이집 70 필드 상세)
