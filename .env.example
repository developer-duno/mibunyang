# ─── 미분양 아파트 비교 엔진 — 환경변수 목록 ───
# 값은 비어있음. 실제 키를 채워서 .env.local로 복사하세요.

# ── Supabase (필수) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=          # 서버 전용 (쓰기), 프론트에 노출 금지

# ── 인증 (필수) ──
AUTH_SECRET=                   # JWT 서명 비밀키 (64자 hex 권장)
ADMIN_EMAIL=                   # 관리자 이메일

# ── Vercel KV / Redis (인증 세션) ──
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── 프론트엔드 (VITE_ 접두사 = 클라이언트 노출) ──
VITE_USE_SUPABASE=true
VITE_KAKAO_JS_KEY=             # Kakao 지도 JavaScript 키
VITE_KAKAO_CHANNEL_ID=         # Kakao 채널 ID

# ── 외부 API 키 (서버 전용) ──
KAKAO_KEY=                     # Kakao REST API 키 (인프라 검색)
KAKAO_REST_API_KEY=            # Kakao REST API 키 (OAuth 토큰 교환, 서버 전용)
KAKAO_REDIRECT_URI=            # 카카오 OAuth 리다이렉트 URI (로컬: http://localhost:5173/oauth/kakao/callback)
APPLYHOME_KEY=                 # 청약홈 API 키
KOSIS_KEY=                     # 통계청 KOSIS API 키
NEIS_KEY=                      # 교육정보 NEIS API 키
DART_KEY=                      # DART 전자공시 API 키
FINLIFE_API_KEY=               # 금융감독원 finlife API 키
MOLIT_KEY=                     # 국토부 data.go.kr API 키 (일일 10,000건 공유)
AIRKOREA_KEY=                  # 에어코리아 대기질 API 키 (별도 쿼터)
SCHOOLINFO_KEY=                # 학교알리미 API 키
# 분양예정 페이지 활성화 (기본 OFF — 베타 단계)
VITE_FEATURE_UPCOMING=false
